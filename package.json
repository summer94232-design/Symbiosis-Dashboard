{
  "name": "my-personal-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "node --test tests/core-logic.test.mjs tests/trade-matrix.test.mjs tests/day-trades.test.mjs tests/day-trade-panel.test.mjs tests/trade-list.test.mjs",
    "test:kms-rules": "firebase emulators:exec --only firestore,storage --config firebase.kms.json --project demo-kms-rules \"node --test tests/kms-rules.test.mjs\"",
    "kms:migrate:dry-run": "node scripts/migrate-kms-notes.mjs",
    "kms:migrate": "node scripts/migrate-kms-notes.mjs --commit",
    "kms:uid-map:dry-run": "node scripts/configure-kms-uid-mappings.mjs",
    "kms:uid-map": "node scripts/configure-kms-uid-mappings.mjs --commit",
    "kms:cleanup:dry-run": "node scripts/cleanup-kms-legacy-storage.mjs",
    "kms:cleanup": "node scripts/cleanup-kms-legacy-storage.mjs --commit",
    "kms:metadata:dry-run": "node scripts/rebuild-kms-metadata.mjs",
    "kms:metadata": "node scripts/rebuild-kms-metadata.mjs --commit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fugle/marketdata": "^1.4.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "d3": "^7.9.0",
    "firebase": "^12.11.0",
    "heic2any": "^0.0.4",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.8.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "yahoo-finance2": "^3.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.26.0",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  }
}
